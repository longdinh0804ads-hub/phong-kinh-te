generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // directUrl: dùng cho `prisma migrate` / `db push` (bypass connection pooler).
  // Trên Supabase: DATABASE_URL = pooler URL (port 6543); DIRECT_DATABASE_URL = direct (port 5432).
  // Local dev / VPS: chỉ cần set 1 url, Prisma sẽ fallback nếu directUrl không có.
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [vector]
}

// =====================================================
// ENUMS
// =====================================================

enum Role {
  SUPER_ADMIN     // Cấp 0 - Quản trị hệ thống (kỹ thuật, không thuộc nghiệp vụ)
  TRUONG_PHONG    // Cấp 1 - Trưởng phòng
  PHO_TP          // Cấp 2 - Phó Trưởng phòng
  TRUONG_BO_PHAN  // Cấp 3 - Trưởng bộ phận
  CHUYEN_VIEN     // Cấp 4 - Chuyên viên
  NHAN_VIEN       // Cấp 5 - Nhân viên
}

enum Department {
  BAN_LANH_DAO
  TAI_CHINH_KE_HOACH
  NONG_NGHIEP_MOI_TRUONG
  XAY_DUNG_CONG_THUONG
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  AWAITING_REVIEW  // Assignee đã hoàn thành, chờ TP/PTP xác nhận
  COMPLETED
  OVERDUE
  CANCELLED
}

enum Priority {
  KHAN_CAP    // Khẩn cấp
  CAO         // Cao
  THUONG      // Thường
  THAP        // Thấp
}

enum TaskSource {
  INTERNAL        // Nội bộ phòng giao
  UBND_DIRECTIVE  // Từ UBND xã
  IHANOI          // Từ phản ánh iHanoi
}

enum TTHCStatus {
  RECEIVED      // Tiếp nhận
  PROCESSING    // Đang xử lý
  COMPLETED     // Hoàn thành
  RETURNED      // Trả lại
}

enum DocType {
  NGHI_DINH      // Nghị định
  THONG_TU       // Thông tư
  QUYET_DINH     // Quyết định
  LUAT           // Luật
  NGHI_QUYET     // Nghị quyết
  CONG_VAN       // Công văn
}

// =====================================================
// AUTH (Better Auth compatible)
// =====================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  passwordHash  String?

  // Phân quyền & vị trí
  role            Role
  department      Department
  // Cho phép TRUONG_BO_PHAN quản nhiều bộ phận (vd: Đinh Xuân Hội phụ trách cả NN-MT + XD-CT).
  // Null/empty → mặc định chỉ quản department chính.
  managedDepartments Department[]
  position        String      // Chức danh: "Trưởng phòng", "Chuyên viên"
  fields          String[]    // Lĩnh vực phụ trách
  areas           String[]    // Địa bàn phụ trách
  teamGroupCode   String?     // "to-1" | "to-2" | null
  isTeamLeader    Boolean     @default(false)
  responsibilities String?    @db.Text  // Mô tả chi tiết trách nhiệm từ QĐ

  isActive  Boolean  @default(true)
  phone     String?

  // ====== FIELD ENCRYPTION INDEX (P3) ======
  /// Blind index cho User.phone (HMAC-SHA256) - cho phép lookup theo số ĐT khi phone đã encrypt
  phoneBidx String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ====== SECURITY FIELDS (P1-P2) ======
  /// Lần đổi mật khẩu gần nhất - dùng cho password expiry (180 ngày cho TP/PTP/SUPER_ADMIN)
  passwordChangedAt    DateTime?
  /// Số lần đăng nhập thất bại liên tiếp (reset khi login thành công)
  failedLoginCount     Int       @default(0)
  /// Tài khoản bị khóa đến thời điểm này (lockout do brute-force)
  lockedUntil          DateTime?
  /// Lý do khóa (vd "5_FAILS_15M", "ADMIN_LOCKED")
  lockReason           String?
  /// 2FA TOTP secret (encrypted) - null nghĩa là chưa enable
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  /// Backup codes 2FA (mảng hash SHA-256 của code 1 lần dùng)
  twoFactorBackupCodes String[]  @default([])
  /// Thời điểm hoạt động gần nhất (cho idle timeout enforcement)
  lastActivityAt       DateTime?
  /// Force change password vào lần login tiếp theo (sau khi admin reset)
  mustChangePassword   Boolean   @default(false)

  // Relations
  sessions          Session[]
  accounts          Account[]
  assignedTasks     Task[]            @relation("TaskAssignee")
  createdTasks      Task[]            @relation("TaskCreator")
  confirmedTasks    Task[]            @relation("TaskConfirmer")
  authoredNotes     TaskNote[]        @relation("TaskNoteAuthor")
  updatedSettings   SystemSetting[]
  adminAuditLogs    AdminAuditLog[]
  progressReports   ProgressReport[]
  workSchedules     WorkSchedule[]
  chatHistories     ChatHistory[]
  conversations     Conversation[]
  uploadedDocs      LegalDocument[]
  notifications     Notification[]
  iHanoiHandled     IHanoiComplaint[]
  tthcHandled       TTHCRecord[]
  ubndAssigned      UBNDDirective[]   @relation("UBNDAssignee")
  aiAuditLogs       AIAuditLog[]
  passwordHistory   PasswordHistory[]
  loginAttempts     LoginAttempt[]
  trustedDevices    TrustedDevice[]
  securityEvents    SecurityEvent[]

  @@index([role])
  @@index([department])
  @@index([teamGroupCode])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ====== SECURITY BINDING (P1.6) ======
  /// SHA-256 fingerprint thiết bị (canvas + WebGL + fonts + timezone)
  deviceId          String?
  /// Tên hiển thị (vd "Chrome 130 / Windows 11")
  deviceName        String?
  /// FK tới TrustedDevice nếu user đã xác nhận tin cậy
  trustedDeviceId   String?
  /// Subnet /24 của IP đăng nhập (dùng để detect IP drift)
  ipSubnet          String?
  /// Hash User-Agent rút gọn (browser+OS) - so sánh lúc resolve
  userAgentHash     String?
  /// Lần activity gần nhất (phục vụ idle timeout 30 phút)
  lastActivityAt    DateTime?
  /// Đã pass 2FA challenge chưa
  twoFactorVerified Boolean   @default(false)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  providerId   String
  password     String?
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// =====================================================
// TASK MANAGEMENT
// =====================================================

model TaskGroup {
  id          String   @id @default(cuid())
  name        String   // "Tổ 1", "Tổ 2"
  code        String   @unique // "to-1", "to-2"
  description String?
  area        String?  // Địa bàn quản lý
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("task_groups")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(THUONG)
  deadline    DateTime
  startedAt   DateTime?
  completedAt DateTime?

  // Người được giao (cá nhân HOẶC nhóm)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  taskGroupId String?
  taskGroup   TaskGroup? @relation(fields: [taskGroupId], references: [id])

  // Người giao
  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  // Người TP/PTP xác nhận hoàn thành (sau khi assignee gửi)
  submittedAt    DateTime?
  confirmedById  String?
  confirmedBy    User?     @relation("TaskConfirmer", fields: [confirmedById], references: [id])
  confirmedAt    DateTime?

  // Sub-tasks
  parentTaskId String?
  parentTask   Task?   @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     Task[]  @relation("SubTasks")

  attachments String[] // File paths

  // Nguồn nhiệm vụ
  sourceType TaskSource @default(INTERNAL)
  sourceId   String?    // FK tới UBNDDirective hoặc IHanoiComplaint

  // Tham chiếu văn bản pháp lý
  legalReferences String[]

  progressReports ProgressReport[]
  notes           TaskNote[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([assigneeId])
  @@index([taskGroupId])
  @@index([creatorId])
  @@index([status])
  @@index([deadline])
  @@index([sourceType, sourceId])
  @@map("tasks")
}

model ProgressReport {
  id              String  @id @default(cuid())
  taskId          String
  task            Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reporterId      String
  reporter        User    @relation(fields: [reporterId], references: [id])
  percentComplete Int     // 0-100
  notes           String? @db.Text
  blockers        String? @db.Text
  weekNumber      Int?
  monthNumber     Int?
  year            Int?
  attachments     String[]
  createdAt       DateTime @default(now())

  @@index([taskId])
  @@index([reporterId])
  @@index([year, weekNumber])
  @@index([year, monthNumber])
  @@map("progress_reports")
}

/// Lời nhắn / nhắc nhở của lãnh đạo trên 1 task.
/// Comment-thread style: nhiều note/task, hiển thị theo thứ tự ghim trước + mới nhất.
model TaskNote {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TaskNoteAuthor", fields: [authorId], references: [id])
  content   String   @db.Text

  // Snapshot tên + chức vụ lúc tạo (immutable - giữ context lịch sử)
  authorName     String
  authorPosition String
  authorRole     Role

  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_notes")
}

// =====================================================
// UBND DIRECTIVES & WORK SCHEDULE
// =====================================================

model UBNDDirective {
  id           String     @id @default(cuid())
  documentNo   String?    // Số văn bản
  title        String
  content      String?    @db.Text
  issuedBy     String     @default("UBND Xã Trần Phú")
  issuedDate   DateTime
  receivedDate DateTime   @default(now())
  deadline     DateTime
  status       TaskStatus @default(PENDING)

  assigneeId    String?    // Cán bộ được giao chính
  assignee      User?      @relation("UBNDAssignee", fields: [assigneeId], references: [id])
  phongResponse String?    @db.Text
  responseDate  DateTime?
  attachments   String[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([deadline])
  @@map("ubnd_directives")
}

model WorkSchedule {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?   @db.Text
  scheduleDate DateTime
  endDate      DateTime?
  location     String?
  weekNumber   Int
  monthNumber  Int
  year         Int
  isAllDay     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([year, weekNumber])
  @@index([year, monthNumber])
  @@map("work_schedules")
}

// =====================================================
// iHANOI & TTHC
// =====================================================

model IHanoiComplaint {
  id           String     @id @default(cuid())
  ticketCode   String     @unique
  content      String     @db.Text
  citizenName  String?
  citizenPhone String?
  citizenAddress String?
  receivedDate DateTime
  deadline     DateTime?
  assigneeId   String?
  assignee     User?      @relation(fields: [assigneeId], references: [id])
  status       TaskStatus @default(PENDING)
  resolution   String?    @db.Text
  resolvedDate DateTime?
  attachments  String[]

  // ====== BLIND INDEX (P3) - hỗ trợ search citizen ======
  /// Trigram blind index của citizenName
  citizenNameBidx  String[] @default([])
  /// Exact blind index của citizenPhone (lookup theo SĐT)
  citizenPhoneBidx String?

  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([citizenPhoneBidx])
  @@map("ihanoi_complaints")
}

model TTHCRecord {
  id            String     @id @default(cuid())
  procedureCode String     // Mã thủ tục
  procedureName String
  applicantName String
  applicantPhone String?
  receivedDate  DateTime
  deadline      DateTime
  status        TTHCStatus @default(RECEIVED)
  handlerId     String?
  handler       User?      @relation(fields: [handlerId], references: [id])
  area          String?    // Địa bàn (Tổ 1/Tổ 2/...)
  notes         String?    @db.Text
  resultFiles   String[]

  // ====== BLIND INDEX (P3) ======
  /// Trigram blind index của applicantName
  applicantNameBidx  String[] @default([])
  /// Exact blind index của applicantPhone
  applicantPhoneBidx String?

  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([handlerId])
  @@index([status])
  @@index([procedureCode])
  @@index([applicantPhoneBidx])
  @@map("tthc_records")
}

// =====================================================
// AI LEGAL ASSISTANT (RAG)
// =====================================================

model LegalDocument {
  id            String       @id @default(cuid())
  title         String
  docType       DocType
  docNumber     String
  issuedDate    DateTime
  effectiveDate DateTime
  status        String       @default("active") // "active" | "superseded" | "expired"
  supersededBy  String?
  filePath      String?
  uploadedById  String?
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id])
  summary       String?      @db.Text
  chunks        LegalChunk[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([docType, docNumber])
  @@index([status])
  @@map("legal_documents")
}

model LegalChunk {
  id         String        @id @default(cuid())
  documentId String
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  article    String?       // "Điều 5"
  section    String?       // "Khoản 2"
  point      String?       // "Điểm a"
  content    String        @db.Text
  // Vector field for pgvector cosine similarity (768 dim, Gemini gemini-embedding-001 Matryoshka)
  // Truy vấn qua raw SQL vì Prisma chưa hỗ trợ vector type native
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime      @default(now())

  @@index([documentId])
  @@map("legal_chunks")
}

// Cuộc hội thoại (thread) - tự động xóa sau 7 ngày
model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?  // Auto-sinh từ câu hỏi đầu (truncate 80 chars)
  isPinned  Boolean  @default(false) // Ghim → không bị auto-xóa
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatHistory[]

  @@index([userId, updatedAt])
  @@index([createdAt])
  @@map("conversations")
}

model ChatHistory {
  id             String        @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       String        @db.Text
  answer         String        @db.Text
  sources        Json?         // Array of {documentId, article, section}
  isSaved        Boolean       @default(false)
  rating         Int?          // 1-5
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("chat_histories")
}

// =====================================================
// NOTIFICATIONS
// =====================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "TASK_ASSIGNED" | "TASK_OVERDUE" | "REPORT_DUE" | "UBND_NEW"
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// =====================================================
// AI AGENT AUDIT LOG
// =====================================================

/// SystemSetting: key-value store cho cấu hình runtime (vd API keys, SMTP, thresholds).
/// Value encrypted bằng AES-256-GCM với BETTER_AUTH_SECRET. Đọc qua lib/system-settings.ts.
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text  // ciphertext (base64) nếu isEncrypted=true
  isEncrypted Boolean  @default(true)
  description String?
  category    String?  // "ai-keys", "smtp", "rate-limit", "general"
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
  @@map("system_settings")
}

/// Health check kết quả cho từng API key (mỗi provider có thể có multi-key).
/// 1 record per (provider, keyIndex) - upsert mỗi lần check.
model ApiKeyHealthCheck {
  id          String   @id @default(cuid())
  provider    String   // "gemini" | "deepseek" | "anthropic"
  keyIndex    Int      // position trong multi-key list (0-based)
  keyPrefix   String   // mask để identify: "AIzaSyA7Rr"
  status      String   // "ok" | "rate_limited" | "invalid" | "network_error" | "timeout"
  latencyMs   Int?
  errorMsg    String?  @db.Text
  httpStatus  Int?
  testedAt    DateTime @default(now())

  @@unique([provider, keyIndex])
  @@index([provider])
  @@map("api_key_health_checks")
}

/// Tracking usage của từng API key qua thời gian (số request + tokens).
/// Mỗi lần gọi LLM (success hoặc fail) ghi 1 record.
/// Cleanup tự động sau 30 ngày (qua cron).
model ApiKeyUsage {
  id               String   @id @default(cuid())
  provider         String   // "gemini" | "deepseek" | "anthropic"
  keyIndex         Int      // position trong multi-key list
  keyPrefix        String   // mask để identify (vd "AIzaSyA7Rr")
  model            String   // model name (vd "gemini-2.5-flash")
  promptTokens    Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  success          Boolean  @default(true)
  errorType        String?  // "rate_limited" | "invalid" | "network" | "timeout" | "other"
  latencyMs        Int?
  createdAt        DateTime @default(now())

  @@index([provider, createdAt])
  @@index([keyPrefix, createdAt])
  @@index([createdAt])
  @@map("api_key_usage")
}

/// Audit log riêng cho hành động của SUPER_ADMIN (khác AIAuditLog cho user nghiệp vụ).
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String   // "settings:update", "user:reset-password", "user:lock", "user:unlock", "maintenance:clear-cache"
  target     String?  // ID hoặc tên đối tượng bị tác động (userId, settingKey, ...)
  details    Json?    // metadata thêm (trước/sau, lý do)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

model AIAuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "tool:createTask", "tool:getTaskStats", "command:parse", "digest:generate"
  action    String
  tool      String?  // tool name nếu là tool call
  input     Json?    // arguments truyền vào
  output    Json?    // kết quả trả về (sanitized)
  success   Boolean  @default(true)
  errorMsg  String?  @db.Text
  duration  Int?     // ms
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("ai_audit_logs")
}

// =====================================================
// SECURITY MODELS (P1 + P2)
// =====================================================

/// Lưu hash 5 password gần nhất để chống reuse.
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("password_history")
}

/// Log mọi lần đăng nhập (thành công + thất bại) để audit + anomaly detection.
model LoginAttempt {
  id         String   @id @default(cuid())
  email      String
  /// Liên kết tới user nếu email khớp (null khi email không tồn tại)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress  String
  userAgent  String?
  deviceId   String?
  success    Boolean
  /// "wrong_password" | "user_not_found" | "locked" | "inactive" | "2fa_required" | "2fa_fail" | "unknown_device" | "captcha_fail"
  failReason String?
  geoCity    String?
  geoCountry String?
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@index([success, createdAt])
  @@map("login_attempts")
}

/// Thiết bị đã đăng nhập (trusted hoặc chưa).
/// Mỗi user × deviceId là 1 record (unique).
model TrustedDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String   // SHA-256 fingerprint
  /// "Chrome 130 / Windows 11 / Hà Nội" - tự sinh hoặc user đặt
  deviceName  String
  ipAddress   String
  geoCity     String?
  geoCountry  String?
  userAgent   String?  @db.Text
  /// User đã xác nhận tin cậy qua email link?
  trusted     Boolean  @default(false)
  trustedAt   DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
  @@map("trusted_devices")
}

/// Sự kiện bảo mật: device mới, IP lạ, locked, password change, 2FA enable/disable...
/// Hiển thị trong /settings/security cho user theo dõi.
model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "NEW_DEVICE" | "NEW_LOCATION" | "ACCOUNT_LOCKED" | "PASSWORD_CHANGED" | "2FA_ENABLED" | "2FA_DISABLED" | "SESSION_REVOKED" | "SUSPICIOUS_LOGIN" | "IMPOSSIBLE_TRAVEL"
  eventType   String
  severity    String   @default("info") // "info" | "warning" | "critical"
  /// Mô tả ngắn hiển thị UI
  description String   @db.Text
  ipAddress   String?
  userAgent   String?  @db.Text
  /// JSON metadata bổ sung (deviceId, geoLocation, etc.)
  metadata    Json?
  /// Đã gửi email cảnh báo chưa
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@map("security_events")
}
