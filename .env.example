# ===== AI Providers (cấu hình ÍT NHẤT 1) =====
# Hỗ trợ MULTI-KEY (round-robin rotation, tránh rate limit):
# - Single key:   PROVIDER_API_KEY=key
# - Multi key:    PROVIDER_API_KEYS=key1,key2,key3

# Anthropic Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=

# Google Gemini - https://aistudio.google.com/apikey (free 15 RPM/key)
GEMINI_API_KEY=
GEMINI_API_KEYS=

# DeepSeek - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=

# Provider mặc định (anthropic | gemini | deepseek). Trống = auto-chọn
AI_PROVIDER=

