<file path="app/components/task/task-status-actions.tsx">
"use client";

import { useTransition } from "react";
import { useRouter } from "next/navigation";
import { Button } from "@/components/ui/button";
import { updateTask } from "@/actions/task";
import { Play, CheckCircle2, X, Loader2 } from "lucide-react";
import type { Task, TaskStatus } from "@prisma/client";

interface Props {
  task: Pick<Task, "id" | "status">;
  canEdit: boolean;
}

export function TaskStatusActions({ task, canEdit }: Props) {
  const router = useRouter();
  const [isPending, startTransition] = useTransition();

  if (!canEdit) return null;

  async function changeStatus(status: TaskStatus) {
    startTransition(async () => {
      await updateTask({ id: task.id, status });
      router.refresh();
    });
  }

  return (
    <div className="flex flex-wrap gap-2">
      {task.status === "PENDING" && (
        <Button onClick={() => changeStatus("IN_PROGRESS")} disabled={isPending} variant="outline">
          {isPending ? <Loader2 className="h-4 w-4 animate-spin" /> : <Play className="h-4 w-4" />}
          Bắt đầu
        </Button>
      )}
      {(task.status === "PENDING" || task.status === "IN_PROGRESS" || task.status === "OVERDUE") && (
        <>
          <Button onClick={() => changeStatus("COMPLETED")} disabled={isPending}>
            {isPending ? <Loader2 className="h-4 w-4 animate-spin" /> : <CheckCircle2 className="h-4 w-4" />}
            Hoàn thành
          </Button>
          <Button onClick={() => changeStatus("CANCELLED")} disabled={isPending} variant="ghost">
            <X className="h-4 w-4" />
            Hủy
          </Button>
        </>
      )}
    </div>
  );
}
