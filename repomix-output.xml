              <Row icon={User} label="Cán bộ xử lý">
                {c.assignee.name}
                <div className="text-xs text-muted-foreground">{c.assignee.position}</div>
              </Row>
            )}
          </CardContent>
        </Card>
      </div>
    </div>
  );
}

function Row({ icon: Icon, label, children }: { icon: any; label: string; children: React.ReactNode }) {
  return (
