      sh -c "while true; do
        pg_dump -h postgres -U ${DB_USER} phong_kinh_te > /backups/backup_$(date +%Y%m%d_%H%M).sql;
        find /backups -name '*.sql' -mtime +30 -delete;
        sleep 86400; done"
