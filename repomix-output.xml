## Database Schema (Prisma)

```prisma
// schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum Role {
  TRUONG_PHONG    // Cấp 1
  PHO_TP          // Cấp 2
  TRUONG_BO_PHAN  // Cấp 3
  CHUYEN_VIEN     // Cấp 4
  NHAN_VIEN       // Cấp 5
}

enum Department {
  BAN_LANH_DAO
  TAI_CHINH_KE_HOACH
  NONG_NGHIEP_MOI_TRUONG
  XAY_DUNG_CO_THON
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role
  department   Department
  position     String     // Chức danh: "Trưởng phòng", "Chuyên viên", v.v.
  fields       String[]   // Lĩnh vực phụ trách: ["Tài chính", "Ngân sách"]
  areas        String[]   // Địa bàn phụ trách: ["Tổ 1", "Tổ 2", ...]
  teamGroupId  String?    // "to-1" | "to-2" | null
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  assignedTasks     Task[]           @relation("TaskAssignee")
  createdTasks      Task[]           @relation("TaskCreator")
  progressReports   ProgressReport[]
  workSchedules     WorkSchedule[]
  chatHistories     ChatHistory[]
  sessions          Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model TaskGroup {
  id        String   @id @default(cuid())
  name      String   // "Tổ 1", "Tổ 2"
  code      String   @unique // "to-1", "to-2"
  tasks     Task[]
  createdAt DateTime @default(now())

  @@map("task_groups")
}

model Task {
  id           String      @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus  @default(PENDING)
  priority     Priority    @default(MEDIUM)
  deadline     DateTime
  assigneeId   String?     // Cá nhân (nullable khi giao cho nhóm)
  assignee     User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  taskGroupId  String?     // Nhóm Tổ 1/Tổ 2
  taskGroup    TaskGroup?  @relation(fields: [taskGroupId], references: [id])
  creatorId    String
  creator      User        @relation("TaskCreator", fields: [creatorId], references: [id])
  parentTaskId String?     // Subtask
  parentTask   Task?       @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     Task[]      @relation("SubTasks")
  attachments  String[]    // File paths
  sourceType   String?     // "UBND_DIRECTIVE" | "INTERNAL" | "IHANOI"
  sourceId     String?     // FK tới UBNDDirective.id
  deletedAt    DateTime?   // Soft delete
  progressReports ProgressReport[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("tasks")
}

model ProgressReport {
  id              String   @id @default(cuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id])
  reporterId      String
  reporter        User     @relation(fields: [reporterId], references: [id])
  percentComplete Int      // 0–100
  notes           String?
  weekNumber      Int?
  monthNumber     Int?
  year            Int?
  createdAt       DateTime @default(now())

  @@map("progress_reports")
}

model UBNDDirective {
  id              String     @id @default(cuid())
  title           String
  content         String?
  issuedBy        String     @default("UBND Xã Trần Phú")
  issuedDate      DateTime
  deadline        DateTime
  status          TaskStatus @default(PENDING)
  phongResponse   String?
  attachments     String[]
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("ubnd_directives")
}

model WorkSchedule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  title        String
  description  String?
  scheduleDate DateTime
  endDate      DateTime?
  location     String?
  weekNumber   Int
  year         Int
  createdAt    DateTime @default(now())

  @@map("work_schedules")
}

model IHanoiComplaint {
  id           String     @id @default(cuid())
  ticketCode   String     @unique // Mã phiếu iHanoi
  content      String
  citizenName  String?
  receivedDate DateTime
  deadline     DateTime?
  assigneeId   String?
  status       TaskStatus @default(PENDING)
  resolution   String?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("ihanoi_complaints")
}

model TTHCRecord {
  id           String   @id @default(cuid())
  procedureCode String  // Mã thủ tục
  procedureName String
  applicantName String
  receivedDate  DateTime
  deadline      DateTime
  status        String  // "RECEIVED" | "PROCESSING" | "COMPLETED" | "RETURNED"
  handlerId     String?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("tthc_records")
}

// Phase 04 - AI Legal Assistant
model LegalDocument {
  id            String   @id @default(cuid())
  title         String
  docType       String   // "nghi_dinh" | "thong_tu" | "quyet_dinh"
  docNumber     String
  issuedDate    DateTime
  effectiveDate DateTime
  status        String   @default("active") // "active" | "superseded"
  supersededBy  String?
  filePath      String
  chunks        LegalChunk[]
  createdAt     DateTime @default(now())

  @@map("legal_documents")
}

model LegalChunk {
  id         String                         @id @default(cuid())
  documentId String
  document   LegalDocument                  @relation(fields: [documentId], references: [id])
  chunkIndex Int
  article    String?   // "Điều 5"
  section    String?   // "Khoản 2"
  content    String
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime                       @default(now())

  @@map("legal_chunks")
}

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  question  String
  answer    String
  sources   Json?    // Array of {documentId, article, section}
  createdAt DateTime @default(now())

  @@map("chat_histories")
}
```

