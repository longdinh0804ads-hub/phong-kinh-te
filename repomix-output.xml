import { NextRequest } from "next/server";
import { db } from "@/lib/db";
import { getCurrentUser } from "@/lib/session";
import { canUseAI } from "@/lib/permissions";
import { retrieveRelevantChunks, RAG_SYSTEM_PROMPT, buildRAGUserMessage } from "@/lib/rag";
import { retrieveHybrid } from "@/lib/rag-hybrid";
import {
  retrieveWithArticleExpansion,
  buildArticleGroupedMessage,
  articleGroupsToSources,
} from "@/lib/rag-article-expansion";
import {
  isFollowUpQuestion,
  loadConversationHistory,
  buildChatMessages,
  getChunksFromPreviousSources,
} from "@/lib/rag-conversation";
import { streamChat, getActiveProvider } from "@/lib/ai";

export const runtime = "nodejs";
export const maxDuration = 60;

/**
 * Chat endpoint - server tự chọn AI provider, KHÔNG tiết lộ cho client.
 * User chỉ gửi câu hỏi, không biết model nào đang trả lời.
 */
export async function POST(req: NextRequest) {
  const user = await getCurrentUser();
  if (!user) return new Response("Unauthorized", { status: 401 });
  if (!canUseAI(user.role)) return new Response("Forbidden", { status: 403 });

  const { question, conversationId: clientConvId } = await req.json();
  if (!question || typeof question !== "string" || question.length < 3) {
    return new Response("Invalid question", { status: 400 });
  }

  // Server tự chọn provider - không cho client chỉ định
  const provider = getActiveProvider();

  if (!provider) {
    return streamFallback(
      "Trợ lý AI hiện chưa khả dụng. Vui lòng thử lại sau hoặc liên hệ Trưởng phòng."
    );
  }

  // Get or create conversation
  let conversationId: string;
  if (clientConvId && typeof clientConvId === "string") {
    // Verify ownership
    const existing = await db.conversation.findFirst({
      where: { id: clientConvId, userId: user.id },
    });
    if (existing) {
      conversationId = existing.id;
    } else {
      // Invalid conversationId → tạo mới
      const title = question.length > 80 ? question.slice(0, 77) + "..." : question;
      const conv = await db.conversation.create({
        data: { userId: user.id, title },
      });
      conversationId = conv.id;
    }
  } else {
    // Tạo conversation mới với title từ câu hỏi đầu
    const title = question.length > 80 ? question.slice(0, 77) + "..." : question;
    const conv = await db.conversation.create({
      data: { userId: user.id, title },
    });
    conversationId = conv.id;
  }

  // Load lịch sử hội thoại (5 turns gần nhất)
  const history = await loadConversationHistory(conversationId);
  const isFollowUp = isFollowUpQuestion(question, history.length > 0);

  // RAG: hybrid + article expansion.
  // Nếu follow-up: REUSE chunks từ message trước (không retrieve lại).
  // Nếu không: retrieve fresh trên câu hỏi mới.
  let userMessage: string;
  let sources: Array<{
    documentId: string;
    documentTitle: string;
    article: string | null;
    section: string | null;
  }>;
  let usedReuse = false;

  if (isFollowUp && history.length > 0) {
    // Reuse: pull chunks từ sources của tin nhắn cuối
    const lastMsg = history[history.length - 1];
    const reusedChunks = await getChunksFromPreviousSources(lastMsg.sources);
    if (reusedChunks.length > 0) {
      userMessage = buildRAGUserMessage(question, reusedChunks.map((c) => ({ ...c, score: 1 })));
      sources = reusedChunks.map((c) => ({
        documentId: c.documentId,
        documentTitle: `${c.documentTitle} (${c.documentNumber})`,
        article: c.article,
        section: c.section,
      }));
      usedReuse = true;
    } else {
      // Sources cũ rỗng/lỗi → fallback retrieve mới
      userMessage = "";
      sources = [];
    }
  } else {
    userMessage = "";
    sources = [];
  }

  if (!usedReuse) {
    const articles = await retrieveWithArticleExpansion(question, 3);
    if (articles.length > 0) {
      userMessage = buildArticleGroupedMessage(question, articles);
      sources = articleGroupsToSources(articles);
    } else {
      // Fallback chuỗi: hybrid → BM25 cũ
      let chunks = await retrieveHybrid(question, 8);
      if (chunks.length === 0) {
        chunks = await retrieveRelevantChunks(question, 5);
      }
      userMessage = buildRAGUserMessage(question, chunks);
      sources = chunks.map((c) => ({
        documentId: c.documentId,
        documentTitle: `${c.documentTitle} (${c.documentNumber})`,
        article: c.article,
        section: c.section,
      }));
    }
  }

  // Build messages multi-turn cho LLM
  const messages = buildChatMessages(
    history.map((h) => ({ question: h.question, answer: h.answer })),
    userMessage
  );

  console.log(
    `[chat] conv=${conversationId.slice(0, 8)} | history=${history.length} | ` +
      `followUp=${isFollowUp} | reuseChunks=${usedReuse} | sources=${sources.length}`
  );
  const encoder = new TextEncoder();

  const stream = new ReadableStream({
    async start(controller) {
      try {
        // Gửi conversationId + sources (KHÔNG gửi provider/model info)
        controller.enqueue(
          encoder.encode(`data: ${JSON.stringify({ conversationId, sources })}\n\n`)
        );

        const fullAnswer = await streamChat({
          provider,
          systemPrompt: RAG_SYSTEM_PROMPT,
          messages, // multi-turn: history + current
          maxTokens: 6000,
          onChunk: (text) => {
            controller.enqueue(encoder.encode(`data: ${JSON.stringify({ text })}\n\n`));
          },
        });

        // Lưu lịch sử + touch conversation updatedAt
        await db.chatHistory.create({
          data: {
            conversationId,
            userId: user.id,
            question,
            answer: fullAnswer,
            sources: { _provider: provider, refs: sources } as any,
          },
        });
        await db.conversation.update({
          where: { id: conversationId },
          data: { updatedAt: new Date() },
        });

        controller.enqueue(encoder.encode(`data: [DONE]\n\n`));
        controller.close();
      } catch (e: any) {
        // Sanitize error: KHÔNG để lộ tên provider/SDK trong error message
        const sanitized = sanitizeError(e?.message || "");
        controller.enqueue(
          encoder.encode(`data: ${JSON.stringify({ text: `\n\n[${sanitized}]` })}\n\n`)
        );
        controller.enqueue(encoder.encode(`data: [DONE]\n\n`));
        controller.close();
      }
    },
  });

  return new Response(stream, {
    headers: {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache",
      "Connection": "keep-alive",
    },
  });
}

function sanitizeError(msg: string): string {
  // Loại bỏ tên SDK/provider/URL khỏi error message để không lộ thông tin
  if (/api[_-]?key|unauthorized|invalid.*key/i.test(msg)) {
    return "Lỗi xác thực dịch vụ AI. Vui lòng liên hệ Trưởng phòng.";
  }
  if (/rate.*limit|quota|429/i.test(msg)) {
    return "Đã đạt giới hạn sử dụng AI. Vui lòng thử lại sau ít phút.";
  }
  if (/timeout|network|fetch/i.test(msg)) {
    return "Lỗi kết nối tới dịch vụ AI. Vui lòng thử lại.";
  }
  return "Đã xảy ra lỗi khi xử lý câu hỏi. Vui lòng thử lại.";
}

function streamFallback(message: string) {
  const encoder = new TextEncoder();
  const stream = new ReadableStream({
    start(controller) {
      controller.enqueue(encoder.encode(`data: ${JSON.stringify({ text: message })}\n\n`));
      controller.enqueue(encoder.encode(`data: [DONE]\n\n`));
      controller.close();
    },
  });
  return new Response(stream, {
    headers: {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache",
    },
  });
}
