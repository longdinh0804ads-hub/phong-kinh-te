    "Ưu tiên": PRIORITY_LABELS[t.priority],
    "Thời hạn": formatDate(t.deadline),
    "Người giao": t.creator.name,
    "Người nhận": t.assignee?.name || t.taskGroup?.name || "",
    "Loại nguồn": t.sourceType,
    "Ngày tạo": formatDate(t.createdAt),
