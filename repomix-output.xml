  PHO_TP: "Phó Trưởng phòng",
  TRUONG_BO_PHAN: "Trưởng bộ phận",
  CHUYEN_VIEN: "Chuyên viên",
  NHAN_VIEN: "Nhân viên",
};

export const ROLE_LEVELS: Record<Role, number> = {
  TRUONG_PHONG: 1,
  PHO_TP: 2,
  TRUONG_BO_PHAN: 3,
  CHUYEN_VIEN: 4,
