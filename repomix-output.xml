  console.log(`   Tổng: ${USERS.length} users + 2 task groups`);
  console.log(`   Mật khẩu mặc định: ${DEFAULT_PASSWORD}`);
}

main()
  .catch((e) => {
    console.error("❌ Seed lỗi:", e);
    process.exit(1);
  })
