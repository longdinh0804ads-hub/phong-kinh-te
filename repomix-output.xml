                  <ExampleQuestion onClick={(q) => setInput(q)}>
                    Quy định về xây dựng nhà ở trên đất nông nghiệp?
                  </ExampleQuestion>
                  <ExampleQuestion onClick={(q) => setInput(q)}>
                    Mức xử phạt vi phạm hành chính về môi trường?
                  </ExampleQuestion>
                </div>
              </div>
            ) : (
              messages.map((m) => (
                <div key={m.id} className={cn("flex gap-3", m.role === "user" && "flex-row-reverse")}>
