import { embedText, embedBatch, isEmbeddingAvailable } from "../lib/embeddings";

async function cosine(a: number[], b: number[]): Promise<number> {
  let dot = 0, na = 0, nb = 0;
  for (let i = 0; i < a.length; i++) {
    dot += a[i] * b[i];
    na += a[i] * a[i];
    nb += b[i] * b[i];
  }
  return dot / (Math.sqrt(na) * Math.sqrt(nb));
}

