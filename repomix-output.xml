  XAY_DUNG_CONG_THUONG: "Bộ phận Xây dựng & Công thương",
} as const;

export type Permission =
  | "task:create"
  | "task:assign:all"
  | "task:assign:dept"
  | "task:assign:team"
  | "task:view:all"
  | "task:view:dept"
  | "task:view:own"
  | "task:approve"
  | "task:delete"
  | "report:view:all"
  | "report:view:dept"
  | "report:view:own"
  | "report:create"
  | "report:export"
  | "user:manage"
  | "user:view"
  | "ubnd:create"
  | "ubnd:assign"
  | "ubnd:view"
  | "ihanoi:assign"
  | "ihanoi:handle"
  | "ihanoi:view"
  | "tthc:create"
  | "tthc:handle"
  | "tthc:view"
  | "ai:full"
  | "ai:limited"
  | "legal:upload"
  | "legal:manage"
  | "schedule:manage:all"
  | "schedule:manage:own";

export const PERMISSION_MATRIX: Record<Role, Permission[]> = {
  TRUONG_PHONG: [
    "task:create", "task:assign:all", "task:view:all", "task:approve", "task:delete",
    "report:view:all", "report:create", "report:export",
    "user:manage", "user:view",
    "ubnd:create", "ubnd:assign", "ubnd:view",
    "ihanoi:assign", "ihanoi:view",
    "tthc:create", "tthc:view",
    "ai:full", "legal:upload", "legal:manage",
    "schedule:manage:all",
  ],
  PHO_TP: [
    "task:create", "task:assign:dept", "task:view:all", "task:approve",
    "report:view:all", "report:create", "report:export",
    "user:view",
    "ubnd:assign", "ubnd:view",
    "ihanoi:assign", "ihanoi:view",
    "tthc:create", "tthc:view",
    "ai:full", "legal:upload",
    "schedule:manage:all",
  ],
  TRUONG_BO_PHAN: [
    "task:create", "task:assign:dept", "task:view:dept", "task:approve",
    "report:view:dept", "report:create", "report:export",
    "user:view",
    "ubnd:view",
    "ihanoi:assign", "ihanoi:handle", "ihanoi:view",
    "tthc:create", "tthc:handle", "tthc:view",
    "ai:full", "legal:upload",
    "schedule:manage:all",
  ],
  CHUYEN_VIEN: [
    "task:create", "task:assign:team", "task:view:own",
    "report:view:own", "report:create",
    "ubnd:view",
    "ihanoi:handle", "ihanoi:view",
    "tthc:create", "tthc:handle", "tthc:view",
    "ai:limited",
    "schedule:manage:own",
  ],
  NHAN_VIEN: [
    "task:view:own",
    "report:view:own", "report:create",
    "schedule:manage:own",
  ],
};

export function hasPermission(role: Role, permission: Permission): boolean {
  return PERMISSION_MATRIX[role]?.includes(permission) ?? false;
}

export function canViewAllTasks(role: Role): boolean {
  return hasPermission(role, "task:view:all");
}

export function canAssignTask(role: Role): boolean {
  return (
    hasPermission(role, "task:assign:all") ||
    hasPermission(role, "task:assign:dept") ||
    hasPermission(role, "task:assign:team")
  );
}

export function canManageUsers(role: Role): boolean {
  return hasPermission(role, "user:manage");
}

export function canUseAI(role: Role): boolean {
  return hasPermission(role, "ai:full") || hasPermission(role, "ai:limited");
}

export function isLeader(role: Role): boolean {
  return ROLE_LEVELS[role] <= 3;
}

export function isAdmin(role: Role): boolean {
  return role === "TRUONG_PHONG";
}
